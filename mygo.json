{
  "name": "Miya",
  "identifier": "com.daodao.miya",
  "version": "0.1.0",
  "out": "build",
  "macos": {
    "minimumSystemVersion": "13.0",
    "infoPlist": {
      "NSLocalNetworkUsageDescription": "连接同一 Wi-Fi 下的 Miya 手机端，通过局域网加密直连降低延迟。"
    }
  },
  "urlSchemes": [
    "miya"
  ],
  "ios": {
    "capabilities": [
      "camera"
    ],
    "minimumSystemVersion": "15.0",
    "infoPlist": {
      "NSCameraUsageDescription": "扫描 Miya 桌面端的二维码以查看会话。",
      "NSLocalNetworkUsageDescription": "连接同一 Wi-Fi 下的 Miya 桌面端，通过局域网加密直连降低延迟。",
      "NSAppTransportSecurity": {
        "NSAllowsLocalNetworking": true
      }
    },
    "buildNumber": "1",
    "developmentTeam": "XNDA84PBM3",
    "entitlements": {
      "keychain-access-groups": [
        "$(AppIdentifierPrefix)*",
        "com.apple.token"
      ]
    },
    "pushNotifications": true,
    "native": {
      "sources": [
        "resources/ios/MiyaFiles.swift"
      ],
      "frameworks": [
        "WebKit",
        "QuickLook"
      ]
    }
  }
}
